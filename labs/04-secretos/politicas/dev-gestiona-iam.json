{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerTodo",
      "Effect": "Allow",
      "Action": ["s3:Get*", "s3:List*", "ec2:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "ParaQueSeAutoGestioneSusLlaves",
      "Effect": "Allow",
      "Action": ["iam:CreateAccessKey", "iam:AttachUserPolicy", "iam:PutUserPolicy"],
      "Resource": "*"
    }
  ]
}
